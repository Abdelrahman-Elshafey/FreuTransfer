# Copy to .env (never commit .env). Only `pnpm dev:api` reads this file.
# Local development needs nothing here: without DATABASE_URL the API, Prisma and the seed all use the
# docker-compose database (packages/db/src/local-dev.ts). Production sets DATABASE_URL in the
# server's environment; to point `pnpm db:migrate` / `pnpm db:seed` elsewhere, set it in the shell.
# DATABASE_URL=postgresql://user:password@host:5432/freu_transfer
# The API's port (default 3000). The Vite dev proxy expects 3000 (apps/web/vite.config.ts).
# PORT=3000
