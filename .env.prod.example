# Production settings for compose.prod.yml. On the server: copy to .env.prod (never commit it)
# and fill in the values there; docs/deploy.md shows how. Secrets never go into git or a chat.

# Database password: long and random. Generate one with:  openssl rand -hex 32
# Set it BEFORE the first start: Postgres stores it when it creates the database, and changing
# it here later does not change it in the database.
POSTGRES_PASSWORD=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → freutransfer). Server only.
TUNNEL_TOKEN=
# Starts the services only the server runs: `tunnel` and `offsite` (off-site backup copies).
# scripts/deploy.sh refuses to deploy without exactly this line. Leave unset on your computer.
COMPOSE_PROFILES=tunnel,offsite

# Off-site backups (docs/deploy.md, "Backups"): the Cloudflare R2 bucket and an API token that
# may only read and write this bucket. Server only.
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=freutransfer-backups
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=

# Pull the images CI built instead of building them (server only; your GitHub user, lowercase).
IMAGE_PREFIX=ghcr.io/abdelrahman-elshafey/
# The commit to run. Set by each deploy (docs/deploy.md).
IMAGE_TAG=
