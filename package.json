{
  "name": "freu-transfer",
  "version": "0.0.0",
  "private": true,
  "description": "Money transfer cost comparer for Switzerland ⇄ Europe: what actually arrives, and where the hidden FX cost is.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "dev:api": "pnpm --filter @freu-transfer/api dev",
    "dev:web": "pnpm --filter @freu-transfer/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
