{
  "name": "freu-transfer",
  "version": "0.0.0",
  "private": true,
  "description": "Money transfer cost comparer for Switzerland ⇄ Europe: what actually arrives, and where the hidden FX cost is.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @freu-transfer/db generate",
    "db:migrate": "pnpm --filter @freu-transfer/db migrate:deploy",
    "db:seed": "pnpm --filter @freu-transfer/db seed",
    "check": "pnpm db:generate && pnpm lint && pnpm knip && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "dev:api": "pnpm --filter @freu-transfer/api dev",
    "dev:web": "pnpm --filter @freu-transfer/web dev",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "knip": "^6.44.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
